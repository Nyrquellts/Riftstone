// Riftstone Studio's resources: the manifest (per-monitor DPI, common controls 6, as invoker), the display face
// Riftstone Blade (OFL; its notice travels with the exe as src/riftstone/studio/fonts/README.txt says) and the version.
// build.cmd passes the fonts folder with /I.
#include <winres.h>
#include "version.h"

1 RT_MANIFEST "studio.manifest"
101 RCDATA "riftstone-blade.woff2"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION STUDIO_VERSION_N
 PRODUCTVERSION STUDIO_VERSION_N
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NryQ"
            VALUE "FileDescription", "Riftstone Studio"
            VALUE "FileVersion", STUDIO_VERSION_A
            VALUE "InternalName", "RiftstoneStudio"
            VALUE "LegalCopyright", "Copyright (c) NryQ. MIT licence."
            VALUE "OriginalFilename", "RiftstoneStudio.exe"
            VALUE "ProductName", "Riftstone"
            VALUE "ProductVersion", STUDIO_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
